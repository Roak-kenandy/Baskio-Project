NODE_ENV=development
PORT=5050
LOG_LEVEL=info

# MySQL: this application's own data (users, sessions, audit logs). Tables are created automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=BAISKOAFU
DB_USER=BAISKOAFU
DB_PASSWORD=
DB_SSL=false
DB_CONNECTION_LIMIT=10

# Existing CRM MongoDB (same cluster Billing-Report-Generation reads). Prefer a user with only the `read` role.
CRM_MONGO_URI=mongodb+srv://<readonly-user>:<password>@<cluster>/CRM
# CRM_DB_NAME=CRM

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (e.g. 1 behind nginx).
TRUST_PROXY=0

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=12
AUDIT_RETENTION_DAYS=400

REPORT_TIMEZONE=Indian/Maldives
REPORT_MEDIANET_TV_TAG=Medianet TV
REPORT_MEDIANET_TV_PRODUCTS=BAISKOAFU
REPORT_OTT_TAG=OTT
REPORT_OTT_PRODUCTS=BAISKOAFU OTT
REPORT_QUERY_TIMEOUT_MS=120000
EXPORT_MAX_ROWS=50000
